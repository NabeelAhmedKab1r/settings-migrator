// Place your key bindings in this file to override the defaults
[
    { "key": "ctrl+shift+alt+d", "command": "editor.action.copyLinesDownAction" },
    { "key": "ctrl+k ctrl+t", "command": "workbench.action.selectTheme" },
    { "key": "alt+up", "command": "editor.action.moveLinesUpAction", "when": "editorTextFocus" },
    { "key": "ctrl+`", "command": "workbench.action.terminal.toggleTerminal" },
    { "key": "cmd+ctrl+f", "command": "workbench.action.toggleFullScreen" },
    { "key": "alt+tab", "command": "workbench.action.nextEditor" },
    { "key": "ctrl+w", "command": "workbench.action.closeActiveEditor" },
    { "key": "ctrl+w", "command": "workbench.action.closeWindow" }
]
