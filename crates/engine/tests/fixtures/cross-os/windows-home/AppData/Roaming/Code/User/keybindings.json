// Place your key bindings in this file to override the defaults
[
    { "key": "ctrl+shift+alt+d", "command": "editor.action.copyLinesDownAction" },
    { "key": "ctrl+k ctrl+t", "command": "workbench.action.selectTheme" },
    { "key": "alt+up", "command": "editor.action.moveLinesUpAction", "when": "editorTextFocus" },
    { "key": "ctrl+tab", "command": "workbench.action.nextEditor" },
    { "key": "win+e", "command": "workbench.view.explorer" },
    { "key": "ctrl+shift+c", "command": "workbench.action.terminal.openNativeConsole", "when": "isWindows" },
    { "key": "f5", "command": "workbench.action.debug.start", "when": "!inDebugMode" }
]
